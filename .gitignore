# ================================
# DATA FILES - IGNORE ALL CSV FILES
# ================================

# Ignore ALL CSV files everywhere (recursive)
**/*.csv

# Ignore specific large data files
data/
!data/.gitkeep
!data/**/README.md
!data/**/.gitkeep

# Keep ONLY sample files and documentation
!**/sample_*.csv
!data/**/README.md

# ================================
# MODEL OUTPUTS AND RESULTS
# ================================

# Ignore results and outputs
results/
outputs/
models/
*.pkl
*.h5
*.model
*.joblib
*.pt
*.pth

# ================================
# DEVELOPMENT FILES
# ================================

# Jupyter notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

